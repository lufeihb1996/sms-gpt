# ===== Supabase（仅服务端使用，严禁添加 NEXT_PUBLIC_ 前缀） =====
SUPABASE_URL=https://your-project.supabase.co
# 新项目优先使用 sb_secret_...；旧项目也可填写 service_role JWT
SUPABASE_SECRET_KEY=sb_secret_xxx
# SUPABASE_SERVICE_ROLE_KEY=

# 部署后的正式域名，用于链接分享预览图
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# 定时释放过期号码接口密钥（至少 16 位随机字符串）
CLEANUP_SECRET=replace_with_a_long_random_secret

# ===== 号码通道 =====
SMSMAN_API_TOKEN=在此填写你的token
SMSMAN_API_BASE=https://api.sms-man.com
SMSMAN_COUNTRY=US
SMSMAN_SERVICE=OpenAI/ChatGPT
SMSMAN_COUNTRY_ID=5
SMSMAN_APPLICATION_ID=2754
SMSMAN_MAX_PRICE=
SMSMAN_CURRENCY=USD

# 不同服务的换号等待时间（ChatGPT 默认 3 分钟，SoulAPP 默认 10 分钟）
SMS_SWAP_WAIT_SECONDS_CHATGPT=180
SMS_SWAP_WAIT_SECONDS_SOULAPP=600
# 单个号码最长保留时间，之后自动检查并 reject
SMS_ORDER_TTL_SECONDS_CHATGPT=180
SMS_ORDER_TTL_SECONDS_SOULAPP=600
